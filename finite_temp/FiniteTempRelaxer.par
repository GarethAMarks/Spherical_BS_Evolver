# Finite-temperature boson-star relaxation parameters
# The parser accepts the same key = value syntax used elsewhere in the repo.

n_gridpoints = 800
rbar_min = 0.0
rbar_max = 1.0

hi_sigma_vals =
lo_sigma_vals =
resolution_factor = 1.0

G = 1.0
mu = 1.0
lambda = 10.0
solitonic = 0
sigma_scale = 1.0

sigma_central = 0.15
alpha_central = 1.0
mu_chem_infty = 0.85

use_shooting_seed = 1
seed_R = 200.0
seed_n_gridpoints = 8001
seed_eigen = 0
seed_frequency_guess = 5.0
seed_freq_epsilon = 1e-12
seed_r_match_fac = 0.85

first_thermalized_only = 0
temperature_target = 1.0e-3
temperature_step = 1e-4
force_continue = 1
decay_exponent = 100
cph_epsilon = 1e-8
pressure_interp_power = 2.0
use_suppression_factor = 0
# 0 = dense Jacobian (legacy), 1 = block-banded Jacobian with bordered solve (much faster, same solutions)
solver_mode = 1

omega_target = 0.885
omega_step = -0.0005
charge_step = 0.0001
sigma_jump_on_fail = 4.0
increment_omega = 0
num_models = 2000

max_newton_iterations = 80
newton_tolerance = 1e-8
jacobian_fd_step = 1e-8
line_search_shrink = 0.5
line_search_min_step = 1e-8

output_profile = profile.dat
